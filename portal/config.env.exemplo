# Configuração do portal. Copie este arquivo para config.env e edite. Linhas começando com # são comentários.
# Não use aspas e não escreva comentários na mesma linha do valor.

# Senha do usuário "admin". Usada só na PRIMEIRA vez que o portal inicia. Escolha uma senha forte.
ADMIN_PASSWORD=TROQUE-ESTA-SENHA

# E-mail do administrador original (permite entrar com o e-mail). Opcional.
# ADMIN_EMAIL=voce@suaempresa.com.br

# --- Opção A: só dentro da rede da empresa (sem HTTPS) ---
# 0.0.0.0 permite acesso de outros computadores da rede. Para acesso só neste servidor, use 127.0.0.1.
PORTAL_HOST=0.0.0.0
PORTAL_PORT=5000

# --- Opção B: acesso pela internet com HTTPS feito pela TI (proxy na frente do portal) ---
# Use PORTAL_HOST=127.0.0.1 e tire o # das duas linhas abaixo:
# HTTPS=1
# TRUST_PROXY=1

# --- Backup: pasta de destino (de preferência outro disco ou pasta de rede). Padrão: pasta backups do portal ---
# PORTAL_BACKUP_DIR=D:\Backups\Portal

# --- SharePoint (opcional; veja o README) ---
# SP_TENANT_ID=
# SP_CLIENT_ID=
# SP_CLIENT_SECRET=

# --- E-mails do portal (convite de cadastro e "esqueci minha senha"). Opcional ---
# Sem isto, o portal funciona, mas não envia e-mails: ao cadastrar alguém, o administrador recebe o link na tela para repassar.
# SMTP_HOST=smtp.suaempresa.com.br
# SMTP_PORT=587
# starttls (padrão, porta 587), ssl (porta 465) ou nenhuma
# SMTP_SEGURANCA=starttls
# SMTP_USER=portal@suaempresa.com.br
# SMTP_PASSWORD=
# SMTP_FROM=portal@suaempresa.com.br
# Endereço pelo qual os clientes acessam o portal (usado nos links dos e-mails), sem barra no final
# PORTAL_URL=https://endossos.suaempresa.com.br
